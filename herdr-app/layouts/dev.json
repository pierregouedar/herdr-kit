{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "hk-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 260
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "hk-pane"
                    },
                    "reveal": "always",
                    "height": 32,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "hk-git",
              "type": "column",
              "children": [
                {
                  "id": "servers",
                  "type": "block",
                  "content": {
                    "mod": "hk-servers"
                  },
                  "size": {
                    "px": 36
                  },
                  "min": 36,
                  "background": "chrome",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 10
                },
                {
                  "id": "subagents",
                  "type": "block",
                  "content": {
                    "mod": "hk-subagents"
                  },
                  "size": {
                    "px": 148
                  },
                  "min": 36,
                  "background": "chrome",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 10
                },
                {
                  "id": "git-follow",
                  "type": "block",
                  "content": {
                    "mod": "git-follow"
                  },
                  "size": {
                    "px": 0
                  }
                }
              ],
              "size": {
                "px": 635
              },
              "min": 360,
              "max": 1100,
              "gap": 8
            }
          ],
          "padding": 8,
          "gap": 8,
          "floating": [
            {
              "id": "hk-toasts",
              "content": {
                "mod": "hk-toasts"
              },
              "edge": "right",
              "align": "start"
            }
          ]
        },
        {
          "id": "bottom",
          "type": "row",
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "hk-usage",
              "type": "block",
              "content": {
                "mod": "hk-usage"
              },
              "size": {
                "px": 720
              }
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": {
    "light": "hk-day",
    "dark": "hk-night"
  },
  "colors": {},
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}