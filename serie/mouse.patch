+    // Mouse: a click selects a commit and opens its detail, a click on the already selected
+    // commit closes it, a double-click runs user command 3, the wheel scrolls the list.
+    fn handle_mouse(&mut self, m: MouseEvent) {
+        let area = self.app_status.view_area;
+        match (&mut self.view, m.kind) {
+            (View::List(view), MouseEventKind::Down(MouseButton::Left)) => {
+                if m.row < area.y || m.row >= area.y + area.height {
+                    return;
+                }
+                view.select_row((m.row - area.y) as usize);
+                let hash = view.as_list_state().selected_commit_hash().as_str().to_string();
+                if !self.is_double_click(hash) {
+                    self.ec.send(AppEvent::OpenDetail);
+                }
+            }
+            (View::Detail(view), MouseEventKind::Down(MouseButton::Left)) => {
+                let list = view.list_area(area);
+                if m.row < list.y || m.row >= list.y + list.height {
+                    return;
+                }
+                let same = view.select_row(self.repository, (m.row - list.y) as usize);
+                let hash = view.as_list_state().selected_commit_hash().as_str().to_string();
+                if !self.is_double_click(hash) && same {
+                    self.ec.send(AppEvent::CloseDetail);
+                }
+            }
+            (View::List(view), MouseEventKind::ScrollDown) => {
+                view.handle_event(UserEventWithCount::new(UserEvent::ScrollDown, 3), KeyEvent::from(KeyCode::Null));
+            }
+            (View::List(view), MouseEventKind::ScrollUp) => {
+                view.handle_event(UserEventWithCount::new(UserEvent::ScrollUp, 3), KeyEvent::from(KeyCode::Null));
+            }
+            _ => {}
+        }
+    }
+
+    // Second click on the same commit within 400 ms: runs user command 3 and returns true.
+    fn is_double_click(&mut self, hash: String) -> bool {
+        let now = std::time::Instant::now();
+        let double = matches!(&self.app_status.last_click, Some((at, h))
+            if *h == hash && now.duration_since(*at).as_millis() < 400);
+        self.app_status.last_click = if double { None } else { Some((now, hash)) };
+        if double {
+            self.ec.send(AppEvent::OpenUserCommand(3));
+        }
+        double
+    }
+
