+    /// Selects the row-th visible row; returns whether it was already selected.
+    pub fn select_row(&mut self, row: usize) -> bool {
+        if row >= self.height || self.offset + row >= self.total {
+            return false;
+        }
+        let same = self.selected == row;
+        self.selected = row;
+        same
